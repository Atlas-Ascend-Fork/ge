#include "kernel_operator.h"

// 行主序按轴拼接（最小演示实现，按字节拷贝未做性能优化）：
//   outer/inner = 轴前/轴后各维乘积；dim0/dim1 = 两路输入轴维大小，total_dim = dim0 + dim1
//   输入 i 的第 r 块第 c 行拷到输出第 r*total_dim + offset_i + c 行（offset_0 = 0，offset_1 = dim0）
extern "C" __global__ __aicore__ void concat_v2_custom(GM_ADDR x0, GM_ADDR x1, GM_ADDR y, uint64_t outer,
                                                       uint64_t inner, uint64_t dim0, uint64_t dim1,
                                                       uint64_t total_dim, uint64_t elem_size)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    __gm__ const uint8_t *input0 = reinterpret_cast<__gm__ const uint8_t *>(x0);
    __gm__ const uint8_t *input1 = reinterpret_cast<__gm__ const uint8_t *>(x1);
    __gm__ uint8_t *output = reinterpret_cast<__gm__ uint8_t *>(y);
    const uint64_t row_bytes = inner * elem_size;

    for (uint64_t r = 0U; r < outer; ++r) {
        for (uint64_t c = 0U; c < dim0; ++c) {
            const uint64_t src = (r * dim0 + c) * row_bytes;
            const uint64_t dst = (r * total_dim + c) * row_bytes;
            for (uint64_t b = 0U; b < row_bytes; ++b) {
                output[dst + b] = input0[src + b];
            }
        }
    }
    for (uint64_t r = 0U; r < outer; ++r) {
        for (uint64_t c = 0U; c < dim1; ++c) {
            const uint64_t src = (r * dim1 + c) * row_bytes;
            const uint64_t dst = (r * total_dim + dim0 + c) * row_bytes;
            for (uint64_t b = 0U; b < row_bytes; ++b) {
                output[dst + b] = input1[src + b];
            }
        }
    }
}

extern "C" void LaunchConcatV2Custom(GM_ADDR x0, GM_ADDR x1, GM_ADDR y, uint64_t outer, uint64_t inner, uint64_t dim0,
                                     uint64_t dim1, uint64_t total_dim, uint64_t elem_size, void *stream)
{
    constexpr uint32_t kBlockNum = 1U;
    concat_v2_custom<<<kBlockNum, nullptr, stream>>>(x0, x1, y, outer, inner, dim0, dim1, total_dim, elem_size);
}
