#include <string_view>

// om2动态当前限制：将内部 OpKernelBin 及其基类 HostResource 的原始头文件内嵌，
// 供生成模型构造二进制资源对象；这不提供独立的稳定 ABI。后续资源恢复移到运行时后，
// 应移除生成模型对 graph/op_kernel_bin.h 和 graph/host_resource/host_resource.h 的依赖。
namespace ge {
std::string_view GetOm2KernelBinHeader() {
  return R"OM2_BIN_HDR_RSRC(@OM2_KERNEL_BIN_CONTENT@)OM2_BIN_HDR_RSRC";
}

std::string_view GetOm2HostResourceHeader() {
  return R"OM2_HOST_RSRC(@OM2_HOST_RESOURCE_CONTENT@)OM2_HOST_RSRC";
}
}  // namespace ge
